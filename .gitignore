# ---- Môi trường / Python ----
.venv/
venv/
env/
# Môi trường dựng tạm để sinh lại hình (không thuộc gói bàn giao)
.venv-build/
.pip-cache/
.mplcache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Dữ liệu (tải lại được bằng scripts/prepare_data.py) ----
data/

# ---- Checkpoint mô hình: nặng ~1.4 GB, không đẩy lên git ----
# Ngoại lệ cho gói bàn giao được khai báo ở CUỐI tệp: gitignore xét theo thứ tự,
# nên mẫu `!` phải đứng SAU mọi mẫu đã loại trừ tệp đó.
results/checkpoints/
results/checkpoints_ext/*
*.pt
*.pth

# ---- Công cụ LaTeX tự chứa (tải lại được) ----
tools/tectonic.exe
tools/tectonic.zip
tools/tectonic
.tectonic-cache/

# ---- Thư mục xuất PDF khi build kiểm tra ----
report-build/

# ---- BẢO MẬT: trạng thái xác thực Google Colab ----
# .colab-home/ chứa .config/colab-cli/token.json (token OAuth truy cập Colab).
# TUYỆT ĐỐI không đẩy lên git. .colab-auth.log có thể chứa URL/authorization code.
.colab-home/
.colab-auth.log

# ---- Gói làm việc với Colab (script giữ lại, tệp nén thì không) ----
.colab-bundle/*.zip

# ---- Sản phẩm phụ của lượt benchmark thử nghiệm ----
results/checkpoints_ext_bench/
results/summary_bench.json

# ---- Sản phẩm phụ khi biên dịch LaTeX ----
report/main.log
*.aux
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# ---- File tạm khi trích xuất đề cương .docx ----
_ex.py
_ex2.py
_docx_math.txt
_docx_paras.txt
_docx_tables.txt

# ---- Hệ điều hành / IDE ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Gói Colab: chỉ giữ script tái lập, bỏ phần dư có thể sinh lại
.colab-bundle/bundle/
.colab-bundle/m8-bundle.zip

# ---- Gói bàn giao: 2 checkpoint đã kiểm chứng + chỉ số đầy đủ khối mở rộng ----
# Đặt Ở CUỐI TỆP để thắng các mẫu loại trừ phía trên. Xem
# results/checkpoints_ext/README.md để biết vì sao chỉ hai tệp .pt được đóng gói.
!results/checkpoints_ext/README.md
!results/checkpoints_ext/E3_L10_s42.pt
!results/checkpoints_ext/E4_L10_s42.pt
!results/checkpoints_ext/*.json
